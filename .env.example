DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/kfstore
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# SMS (NimbaSMS — https://developers.nimbasms.com/). Laisser SMS_API_KEY/SMS_API_SECRET
# vides pour rester en mode "console" (les SMS sont journalisés, pas envoyés).
SMS_PROVIDER=nimba
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=KFSTORE

# IA — chatbot service client et reporting intelligent (OpenAI). Laisser OPENAI_API_KEY vide
# pour rester en mode de repli (répond honnêtement que l'assistant n'est pas configuré, sans
# appel externe).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
